rules_version = '2';
service cloud.firestore {
  function isAuthenticated() {
    return request.auth != null;
  }

  match /databases/{database}/documents {
    // Los mensajes no contienen datos privados. Solo el servidor los administra.
    match /appMessages/{messageId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Cada persona solo puede registrar sus propias interacciones. Los eventos
    // son inmutables y su fecha siempre la asigna el servidor.
    match /appMessageEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'userId',
          'messageId',
          'eventType',
          'appVersionCode',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() > 0
        && request.resource.data.eventType in ['SHOWN', 'DISMISSED', 'OPENED']
        && request.resource.data.appVersionCode is int
        && request.resource.data.appVersionCode > 0
        && request.resource.data.createdAt == request.time;
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
